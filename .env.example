# Telegram Bot Configuration for fps.ms
# Copy this to .env and fill in your values

# Get from @BotFather on Telegram
BOT_TOKEN=

# Get from https://my.telegram.org
API_ID=
API_HASH=

# Your Telegram user ID (send /start to any bot to find it)
OWNER_ID=

# Space-separated list of user IDs allowed to use the bot
AUTH_USERS=

# Optional: HTTP proxy for geo-restricted content
HTTP_PROXY=

# Optional: Chunk size for downloads (in KB, default 128)
CHUNK_SIZE=128
